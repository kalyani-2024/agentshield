# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- required for docker compose -------------------------------------------
POSTGRES_PASSWORD=change-me

# --- API --------------------------------------------------------------------
# Host port the API is published on.
AGENTSHIELD_PORT=8000
# If set, every /v1 request must send it in the X-API-Key header.
AGENTSHIELD_API_KEY=

# --- destination policy -----------------------------------------------------
# Comma-separated. Listed domains override the URL model in both directions.
AGENTSHIELD_ALLOWED_DOMAINS=
AGENTSHIELD_DENIED_DOMAINS=

# --- detection --------------------------------------------------------------
# hybrid | ml | llm | rules      (rules are the fallback in every other mode)
AGENTSHIELD_DETECTOR=hybrid

# LLM judge. Set ONE provider key; leave all empty to run on the ML model alone.
# AGENTSHIELD_LLM_PROVIDER picks one explicitly when several keys are present.
AGENTSHIELD_LLM_PROVIDER=
# Empty = the provider's default (see agentshield/detection/llm_judge.py).
AGENTSHIELD_LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- tool connectors ----------------------------------------------------------
# What /v1/invoke may execute: any of files, email, database, http.
AGENTSHIELD_TOOLS=files,email,database,http
# Files: the only directory read_file / write_file / list_files can touch.
# (In docker compose this is the "workspace" volume at /workspace.)
AGENTSHIELD_WORKSPACE_DIR=workspace
# Database: what query_database reads, over a read-only connection.
# sqlite:///path/to/app.db  or  postgresql://readonly_user:pass@host:5432/appdb
# Empty = query_database is off.
AGENTSHIELD_TOOL_DATABASE_URL=
# Email: a real SMTP account. Empty host = send_email is off.
# Gmail: smtp.gmail.com, port 587, an app password (not your login password).
AGENTSHIELD_SMTP_HOST=
AGENTSHIELD_SMTP_PORT=587
AGENTSHIELD_SMTP_USERNAME=
AGENTSHIELD_SMTP_PASSWORD=
AGENTSHIELD_SMTP_FROM=
AGENTSHIELD_SMTP_STARTTLS=true
AGENTSHIELD_SMTP_SSL=false
# HTTP: internal addresses (localhost, 10.x, 169.254.x ...) are refused unless true.
AGENTSHIELD_HTTP_ALLOW_PRIVATE=false
